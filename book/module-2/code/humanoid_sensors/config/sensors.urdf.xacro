<?xml version="1.0"?>
<!--
  Sensor macros for humanoid robot.
  Include this file in your main URDF to add sensors.

  Usage:
    <xacro:include filename="sensors.urdf.xacro"/>
    <xacro:camera_sensor name="head_camera" parent="head">
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
    </xacro:camera_sensor>
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================ -->
  <!-- RGB Camera Macro -->
  <!-- ============================================ -->
  <xacro:macro name="camera_sensor" params="name parent *origin fov:=1.047 width:=640 height:=480 rate:=30">
    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="0.02 0.04 0.02"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.02 0.04 0.02"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Optical frame (Z forward, X right, Y down) -->
    <link name="${name}_optical_frame"/>
    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="${name}" type="camera">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <visualize>true</visualize>
        <topic>${name}/image_raw</topic>

        <camera name="${name}">
          <horizontal_fov>${fov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ============================================ -->
  <!-- Depth Camera Macro -->
  <!-- ============================================ -->
  <xacro:macro name="depth_camera_sensor" params="name parent *origin width:=640 height:=480 rate:=30 max_depth:=10">
    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="0.03 0.09 0.03"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.15"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="${name}" type="depth_camera">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <topic>${name}</topic>

        <camera name="${name}">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>${max_depth}</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ============================================ -->
  <!-- IMU Sensor Macro -->
  <!-- ============================================ -->
  <xacro:macro name="imu_sensor" params="name parent *origin rate:=100 accel_noise:=0.1 gyro_noise:=0.01">
    <link name="${name}_link">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="${name}" type="imu">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <visualize>false</visualize>
        <topic>${name}/data</topic>

        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>${gyro_noise}</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>${gyro_noise}</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>${gyro_noise}</stddev>
              </noise>
            </z>
          </angular_velocity>

          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>${accel_noise}</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>${accel_noise}</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>${accel_noise}</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ============================================ -->
  <!-- Force/Torque Sensor Macro -->
  <!-- ============================================ -->
  <xacro:macro name="ft_sensor" params="name joint rate:=100">
    <gazebo reference="${joint}">
      <sensor name="${name}" type="force_torque">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <visualize>true</visualize>
        <topic>${name}/wrench</topic>

        <force_torque>
          <frame>child</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- ============================================ -->
  <!-- Contact Sensor Macro -->
  <!-- ============================================ -->
  <xacro:macro name="contact_sensor" params="name link collision_name rate:=100">
    <gazebo reference="${link}">
      <sensor name="${name}" type="contact">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <topic>${name}/contacts</topic>

        <contact>
          <collision>${collision_name}</collision>
        </contact>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
