<?xml version="1.0"?>
<!--
  Humanoid Robot URDF

  A simplified 14-DOF humanoid robot for educational purposes.

  Joint configuration:
  - Head: 1 DOF (pan)
  - Arms: 3 DOF each (shoulder_pitch, shoulder_roll, elbow)
  - Legs: 3 DOF each (hip_pitch, knee, ankle)

  Total: 14 joints
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="humanoid">

  <!-- ==================== Properties ==================== -->

  <!-- Torso dimensions -->
  <xacro:property name="torso_width" value="0.3"/>
  <xacro:property name="torso_depth" value="0.2"/>
  <xacro:property name="torso_height" value="0.5"/>
  <xacro:property name="torso_mass" value="10.0"/>

  <!-- Head dimensions -->
  <xacro:property name="head_radius" value="0.1"/>
  <xacro:property name="head_mass" value="2.0"/>

  <!-- Arm dimensions -->
  <xacro:property name="upper_arm_radius" value="0.04"/>
  <xacro:property name="upper_arm_length" value="0.25"/>
  <xacro:property name="upper_arm_mass" value="2.0"/>

  <xacro:property name="forearm_radius" value="0.03"/>
  <xacro:property name="forearm_length" value="0.2"/>
  <xacro:property name="forearm_mass" value="1.5"/>

  <!-- Leg dimensions -->
  <xacro:property name="upper_leg_radius" value="0.05"/>
  <xacro:property name="upper_leg_length" value="0.3"/>
  <xacro:property name="upper_leg_mass" value="3.0"/>

  <xacro:property name="lower_leg_radius" value="0.04"/>
  <xacro:property name="lower_leg_length" value="0.3"/>
  <xacro:property name="lower_leg_mass" value="2.0"/>

  <xacro:property name="foot_width" value="0.1"/>
  <xacro:property name="foot_length" value="0.15"/>
  <xacro:property name="foot_height" value="0.05"/>
  <xacro:property name="foot_mass" value="0.5"/>

  <!-- ==================== Materials ==================== -->

  <material name="silver">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>

  <!-- ==================== Inertia Macros ==================== -->

  <xacro:macro name="box_inertia" params="mass width depth height">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass*(depth*depth + height*height)/12}"
        ixy="0" ixz="0"
        iyy="${mass*(width*width + height*height)/12}"
        iyz="0"
        izz="${mass*(width*width + depth*depth)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass*(3*radius*radius + length*length)/12}"
        ixy="0" ixz="0"
        iyy="${mass*(3*radius*radius + length*length)/12}"
        iyz="0"
        izz="${mass*radius*radius/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass radius">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${2*mass*radius*radius/5}"
        ixy="0" ixz="0"
        iyy="${2*mass*radius*radius/5}"
        iyz="0"
        izz="${2*mass*radius*radius/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== Base Link (Torso) ==================== -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${torso_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_width} ${torso_depth} ${torso_height}"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${torso_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_width} ${torso_depth} ${torso_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia mass="${torso_mass}"
                       width="${torso_width}"
                       depth="${torso_depth}"
                       height="${torso_height}"/>
  </link>

  <!-- ==================== Head ==================== -->

  <link name="head">
    <visual>
      <origin xyz="0 0 ${head_radius}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${head_radius}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${head_radius}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${head_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia mass="${head_mass}" radius="${head_radius}"/>
  </link>

  <joint name="head_pan" type="revolute">
    <parent link="base_link"/>
    <child link="head"/>
    <origin xyz="0 0 ${torso_height + 0.05}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="2"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- ==================== Arm Macro ==================== -->

  <xacro:macro name="arm" params="prefix reflect">
    <!-- Upper Arm -->
    <link name="${prefix}_upper_arm">
      <visual>
        <origin xyz="0 0 ${-upper_arm_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${upper_arm_radius}" length="${upper_arm_length}"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-upper_arm_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${upper_arm_radius}" length="${upper_arm_length}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="${upper_arm_mass}"
                              radius="${upper_arm_radius}"
                              length="${upper_arm_length}"/>
    </link>

    <joint name="${prefix}_shoulder_pitch" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_upper_arm"/>
      <origin xyz="${reflect * torso_width/2} 0 ${torso_height - 0.05}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14" upper="1.57" effort="50" velocity="2"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- Forearm -->
    <link name="${prefix}_forearm">
      <visual>
        <origin xyz="0 0 ${-forearm_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${forearm_radius}" length="${forearm_length}"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-forearm_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${forearm_radius}" length="${forearm_length}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="${forearm_mass}"
                              radius="${forearm_radius}"
                              length="${forearm_length}"/>
    </link>

    <joint name="${prefix}_elbow" type="revolute">
      <parent link="${prefix}_upper_arm"/>
      <child link="${prefix}_forearm"/>
      <origin xyz="0 0 ${-upper_arm_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="2.5" effort="30" velocity="2"/>
      <dynamics damping="0.3" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- ==================== Leg Macro ==================== -->

  <xacro:macro name="leg" params="prefix reflect">
    <!-- Upper Leg -->
    <link name="${prefix}_upper_leg">
      <visual>
        <origin xyz="0 0 ${-upper_leg_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${upper_leg_radius}" length="${upper_leg_length}"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-upper_leg_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${upper_leg_radius}" length="${upper_leg_length}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="${upper_leg_mass}"
                              radius="${upper_leg_radius}"
                              length="${upper_leg_length}"/>
    </link>

    <joint name="${prefix}_hip_pitch" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_upper_leg"/>
      <origin xyz="${reflect * 0.1} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="100" velocity="2"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- Lower Leg -->
    <link name="${prefix}_lower_leg">
      <visual>
        <origin xyz="0 0 ${-lower_leg_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lower_leg_radius}" length="${lower_leg_length}"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-lower_leg_length/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lower_leg_radius}" length="${lower_leg_length}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="${lower_leg_mass}"
                              radius="${lower_leg_radius}"
                              length="${lower_leg_length}"/>
    </link>

    <joint name="${prefix}_knee" type="revolute">
      <parent link="${prefix}_upper_leg"/>
      <child link="${prefix}_lower_leg"/>
      <origin xyz="0 0 ${-upper_leg_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="2.5" effort="80" velocity="2"/>
      <dynamics damping="0.3" friction="0.1"/>
    </joint>

    <!-- Foot -->
    <link name="${prefix}_foot">
      <visual>
        <origin xyz="${foot_length/4} 0 ${-foot_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${foot_length} ${foot_width} ${foot_height}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="${foot_length/4} 0 ${-foot_height/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${foot_length} ${foot_width} ${foot_height}"/>
        </geometry>
      </collision>
      <xacro:box_inertia mass="${foot_mass}"
                         width="${foot_width}"
                         depth="${foot_length}"
                         height="${foot_height}"/>
    </link>

    <joint name="${prefix}_ankle" type="revolute">
      <parent link="${prefix}_lower_leg"/>
      <child link="${prefix}_foot"/>
      <origin xyz="0 0 ${-lower_leg_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.8" upper="0.8" effort="50" velocity="2"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- ==================== Instantiate Arms and Legs ==================== -->

  <xacro:arm prefix="left" reflect="1"/>
  <xacro:arm prefix="right" reflect="-1"/>

  <xacro:leg prefix="left" reflect="1"/>
  <xacro:leg prefix="right" reflect="-1"/>

</robot>
